# Copy to server/.env (ignored by git) or set these as environment variables.

# Leave empty to store data in a local SQLite file instead.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=noise_map

# Shared upload key. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The boxes need the same value in night-noise-box/.env.
NOISE_MAP_KEY=
