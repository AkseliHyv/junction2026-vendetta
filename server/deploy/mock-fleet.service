# Runs the Noise Hunt game's 141 mock boxes nonstop against the local map server.
# Install with:
#   sudo cp server/deploy/mock-fleet.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mock-fleet
#
# One upload per box every 5 minutes, with 1-minute readings: about 0.5 uploads
# a second in total, which the MongoDB Atlas free tier handles comfortably.
# NOISE_MAP_KEY comes from server/.env.

[Unit]
Description=Mock Night-Noise Boxes
After=noise-map.service
Wants=noise-map.service

[Service]
User=noisemap
WorkingDirectory=/opt/noise-map
EnvironmentFile=/opt/noise-map/server/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/noise-map/venv/bin/python mock-devices/mock_fleet.py --city \
    --ids mock-devices/game-boxes.txt --server http://127.0.0.1:8080 \
    --analysis-seconds 300 --reading-seconds 60 --status-port 0 --quiet
Restart=on-failure
RestartSec=10
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
